# Example Streamlit secrets file.
#
# The current app uses NO secrets — every tool runs entirely client-side.
# This template exists so that, if you later add server-side integrations
# (a database, an API key, etc.), the expected shape is documented.
#
# To use it:
#   1. Copy this file to .streamlit/secrets.toml
#      (the real secrets.toml is gitignored and must NOT be committed)
#   2. Fill in real values
#   3. Read them in code via st.secrets["section"]["key"]
#
# Docs: https://docs.streamlit.io/develop/concepts/connections/secrets-management

# --- Examples (all commented out; uncomment and edit as needed) ---

# A simple top-level secret:
# some_api_key = "your-key-here"

# A grouped section (access via st.secrets["database"]["host"]):
# [database]
# host = "localhost"
# port = 5432
# username = "app_user"
# password = "change-me"
